# Configuration of the local producer / consumer. Edit this file to target another
# queue manager or cluster; the scripts do not need to be changed.
# A variable already set in the environment wins over this file, e.g.:
#   PRODUCE_DELAY_MS=500 ./producer.sh

# --- MQ client installation (amqsputc, dmpmqmsg, runmqakm)
MQ_HOME=/home/itzuser/mqc

# --- Queue manager, as seen by the client
# Route of the queue manager (passthrough, port 443 on OpenShift)
MQ_HOST=mq-nativeha-ibm-mq-qm-ibm-mq.apps.itz-iscex5.infra01-lb.fra02.techzone.ibm.com
MQ_PORT=443
QMGR=MQNATIVEHA
CHANNEL=TEST.SVRCONN
QUEUE=TEST.QUEUE

# --- Time zone of the timestamps printed by the scripts
# UTC = same clock as `oc logs` on the pods (which run in UTC)
TZ=UTC

# --- Rates
# delay between two messages, in ms
PRODUCE_DELAY_MS=2000
# delay between two messages, in ms (0 = none)
CONSUME_DELAY_MS=0

# --- Client certificates (config/get-certs.sh only)
# namespace of the queue manager, where the certificates are issued
NS=ibm-mq
# issuer of the client certificates: the one the queue manager trusts
CLIENTS_ISSUER_KIND=ClusterIssuer
CLIENTS_ISSUER=clients-ca-issuer
# existing secret holding the CA of the queue manager certificate (key ca.crt)
SERVER_CA_SECRET=mq-nativeha-server-tls
