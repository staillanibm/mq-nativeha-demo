{
  "channel": [
    {
      "name": "${CHANNEL}",
      "type": "clientConnection",
      "clientConnection": {
        "connection": [
          { "host": "${MQ_HOST}", "port": ${MQ_PORT} }
        ],
        "queueManager": "${QMGR}"
      },
      "transmissionSecurity": {
        "cipherSpecification": "ANY_TLS12_OR_HIGHER",
        "certificateLabel": "mqclient"
      }
    }
  ]
}
