# Configuration of the mq-test-java cli producer / consumer. Copy this file to .env and edit it
# to target another queue manager or cluster; the scripts do not need to be changed.
# A variable already set in the environment wins over this file, e.g.:
#   SEND_INTERVAL_MILLIS=500 ./producer.sh

# --- MQ client installation (amqsputc, dmpmqmsg, runmqakm)
MQ_HOME=/home/youruser/mqc

# --- Queue manager, as seen by the client
# Route of the queue manager (passthrough, port 443 on OpenShift)
MQ_HOST=<your-qm-route>
MQ_PORT=443
MQ_QMGR=MQNATIVEHA
MQ_CHANNEL=TEST.SVRCONN
MQ_QUEUE=TEST.QUEUE

# --- TLS keystores (built by config/build-keystores.sh, passwords updated by config/get-certs.sh)
MQ_TRUSTSTORE_PATH=certs/truststore.p12
MQ_KEYSTORE_PASSWORD=changeit
MQ_TRUSTSTORE_PASSWORD=changeit

# --- Rates
# delay between two messages, in ms
SEND_INTERVAL_MILLIS=1000
# delay between two messages, in ms (0 = drain at full speed)
RECEIVE_INTERVAL_MILLIS=2000

# --- Client certificates (config/get-certs.sh only)
# namespace of the queue manager, where the TLS secrets and certificates reside
OC_NAMESPACE=ibm-mq
# issuer of the client certificates: the one the queue manager trusts
CLIENTS_ISSUER_KIND=ClusterIssuer
CLIENTS_ISSUER=clients-ca-issuer
# existing secret holding the CA of the queue manager certificate (key ca.crt)
SERVER_CA_SECRET=mq-nativeha-server-tls
